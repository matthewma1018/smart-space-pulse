# AWS IoT Core (MQTT Broker)
MQTT_HOST=XXXXXXXXXXXXX-ats.iot.us-east-1.amazonaws.com
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_CA_CERT=config/certs/AmazonRootCA1.pem
MQTT_CLIENT_CERT=config/certs/certificate.pem.crt
MQTT_CLIENT_KEY=config/certs/private.pem.key
MQTT_THING_NAME=Core2Kit

# Fallback: local broker for development without AWS
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_USE_TLS=false

# Parallel local pipeline (LSTM): live_bridge.py publishes to AWS *and* this
# broker simultaneously, so the LSTM half keeps running if AWS is down.
# Run a local Mosquitto on the same machine (default install listens on 1883).
# processing/ingestor.py subscribes here, writes SQLite; dashboard reads SQLite
# as a fallback when DynamoDB is unreachable.
LOCAL_MQTT_HOST=localhost
LOCAL_MQTT_PORT=1883
SQLITE_PATH=data/ssp.db

# Storage — DynamoDB
AWS_REGION=us-east-1
DYNAMO_TELEMETRY_TABLE=ssp-telemetry
DYNAMO_STATE_TABLE=ssp-state

# Model
MODEL_WEIGHTS_PATH=processing/model/lstm_weights.pt
SCORE_HIGH_THRESHOLD=65
SCORE_LOW_THRESHOLD=55

# Observability
LOG_LEVEL=INFO
