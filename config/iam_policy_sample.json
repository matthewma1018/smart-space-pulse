{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iot:Connect"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:client/Core2Kit*",
        "arn:aws:iot:us-east-1:123456789012:client/ssp-ingestor"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:topic/ssp/*/telemetry",
        "arn:aws:iot:us-east-1:123456789012:topic/ssp/*/state",
        "arn:aws:iot:us-east-1:123456789012:topic/ssp/*/alert",
        "arn:aws:iot:us-east-1:123456789012:topic/ssp/*/heartbeat"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Subscribe"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:topicfilter/ssp/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:topic/ssp/*"
      ]
    }
  ]
}
